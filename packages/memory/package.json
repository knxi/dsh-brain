{
  "name": "@dsh-brain/memory",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "主账：schema/迁移/单写入队列/事务/outbox/幂等摄取/删除屏障/备份骨架 + M2 记忆门面与检索集成",
  "main": "./src/index.js",
  "bin": {
