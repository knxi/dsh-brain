    "./db": "./src/db.js",
    "./migrator": "./src/migrator.js",
    "./write-queue": "./src/write-queue.js",
    "./ledger": "./src/ledger.js",
    "./outbox": "./src/outbox.js",
    "./consumers": "./src/consumers.js",
    "./deletion": "./src/deletion.js",
    "./deletion-ledger": "./src/deletion-ledger.js",
    "./deletion-worker": "./src/deletion-worker.js",
    "./correction": "./src/correction.js",
    "./backup": "./src/backup.js",
    "./restore": "./src/restore.js",
    "./memories": "./src/memories.js",
    "./sources": "./src/sources.js",
    "./snapshots": "./src/snapshots.js",
    "./summaries": "./src/summaries.js",
    "./context-packages": "./src/context-packages.js",
    "./search-bridge": "./src/search-bridge.js",
    "./memory-util": "./src/memory-util.js"
  },
  "dependencies": {
    "@dsh-brain/core": "workspace:*",
    "@dsh-brain/search": "workspace:*",
